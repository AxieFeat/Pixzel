root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

ij_continuation_indent_size = 8
ij_smart_tabs = true

[*.{kt,kts}]
max_line_length = 150
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647
ij_kotlin_keep_simple_blocks_in_one_line = false
ij_kotlin_keep_simple_methods_in_one_line = false
ij_kotlin_keep_simple_classes_in_one_line = false
ij_kotlin_keep_multiple_expressions_in_one_line = false
ij_kotlin_keep_control_statement_in_one_line = false
ij_kotlin_blank_lines_after_class_header = 1
ij_kotlin_wrap_long_lines = false

[*.{json,conf}]
indent_size = 2
insert_final_newline = false

[*.{yaml,yml}]
indent_size = 2

[{*.xml,Dockerfile}]
insert_final_newline = false
